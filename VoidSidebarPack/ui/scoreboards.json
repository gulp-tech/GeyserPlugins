{
  "namespace": "scoreboard",
  "scoreboard_sidebar_score": {
    "type": "label",
    "visible": false,
    "text": "",
    "size": [
      0,
      0
    ],
    "alpha": 0.0,
    "locked_alpha": 0.0
  },
  "scoreboard_sidebar_player": {
    "type": "label",
    "layer": 2,
    "text": "#player_name_sidebar",
    "size": [
      "default",
      10
    ],
    "max_size": [
      100,
      10
    ],
    "locked_alpha": 1.0,
    "color": "$player_name_color",
    "localize": false,
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      }
    ]
  },
  "scoreboard_sidebar": {
    "type": "panel",
    "size": [
      "100%cm",
      "100%c"
    ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "controls": [
      {
        "main": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": "#alpha",
          "size": [
            "100%cm + 4px",
            "100%c"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "bindings": [
            {
              "binding_name": "#objective_background_opacity",
              "binding_name_override": "#alpha"
            }
          ],
          "controls": [
            {
              "voidpe_logo": {
                "type": "image",
                "texture": "textures/ui/voidpe_logo",
                "size": [
                  "100% - 4px",
                  14
                ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [
                  0,
                  1
                ],
                "layer": 3
              }
            },
            {
              "lists": {
                "type": "panel",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "inherit_max_sibling_width": true,
                "offset": [
                  0,
                  16
                ],
                "size": [
                  "100%c",
                  "100%cm"
                ],
                "controls": [
                  {
                    "players": {
                      "type": "stack_panel",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "size": [
                        "100%cm",
                        "100%c"
                      ],
                      "orientation": "vertical",
                      "collection_name": "scoreboard_players",
                      "factory": {
                        "name": "player_list_factory",
                        "control_name": "scoreboard.scoreboard_sidebar_player"
                      },
                      "bindings": [
                        {
                          "binding_name": "#scoreboard_sidebar_size",
                          "binding_type": "global",
                          "binding_name_override": "#collection_length"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
